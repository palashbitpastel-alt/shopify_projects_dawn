<style>
.rf-broken {
  background: #000;
  width: 100%;
  position: relative;
}

/* Pinned area for scene 1 + 2 */
.rf-broken__pinned {
  height: 300vh;
  position: relative;
}

.rf-broken__sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0 5%;
}

/* --- Part 1: Image + first paragraph --- */
.rf-broken__scene1 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 700px;
  gap: 40px;
}

.rf-broken__image-wrap {
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  overflow: hidden;
  max-width: 440px;
  width: 100%;
  opacity: 0.4;
  transform: translateY(-40px);
}

.rf-broken__image-wrap img {
  width: 100%;
  height: auto;
  display: block;
}

.rf-broken__caption {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  margin: 12px 0 0;
}

.rf-broken__text1 {
  font-size: clamp(18px, 2.5vw, 22px);
  color: #ffffff;
  line-height: 1.7;
  text-align: center;
  margin: 0;
}

.rf-broken__text1 .word {
  display: inline;
  color: rgba(255, 255, 255, 0.2);
  transition: color 0.15s ease;
}

.rf-broken__text1 .word.is-lit {
  color: #ffffff;
}

/* --- Part 2: Big headline --- */
.rf-broken__scene2 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  max-width: 900px;
  text-align: center;
  opacity: 0;
}

.rf-broken__headline {
  font-size: clamp(42px, 6vw, 72px);
  font-weight: 900;
  color: #ffffff;
  line-height: 1.1;
  margin: 0;
}

.rf-broken__headline .char {
  display: inline-block;
  opacity: 0;
  filter: blur(8px);
  transform: translateY(10px);
  transition: opacity 0.2s ease, filter 0.3s ease, transform 0.2s ease;
}

.rf-broken__headline .char.is-visible {
  opacity: 1;
  filter: blur(0);
  transform: translateY(0);
}

.rf-broken__headline .char-space {
  display: inline;
  width: 0.3em;
}

/* --- Part 3: Second paragraph (NOT pinned, normal scroll) --- */
.rf-broken__scene3 {
  padding: 120px 5%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rf-broken__text2 {
  font-size: clamp(17px, 2.2vw, 20px);
  color: #ffffff;
  line-height: 1.7;
  margin: 0;
  max-width: 800px;
  text-align: center;
}

.rf-broken__text2 .word {
  display: inline;
  color: rgba(255, 255, 255, 0.2);
  transition: color 0.15s ease;
}

.rf-broken__text2 .word.is-lit {
  color: #ffffff;
}

@media (max-width: 749px) {
  .rf-broken__pinned {
    height: 250vh;
  }

  .rf-broken__scene1 {
    gap: 24px;
    padding: 0 16px;
  }

  .rf-broken__image-wrap {
    max-width: 300px;
  }

  .rf-broken__scene3 {
    padding: 80px 5%;
  }
}
</style>

<section class="rf-broken" data-section-id="{{ section.id }}">
  <!-- Pinned area: scene 1 + scene 2 -->
  <div class="rf-broken__pinned">
    <div class="rf-broken__sticky">
      <div class="rf-broken__scene1" data-scene="1">
        {%- if section.settings.image != blank -%}
          <div class="rf-broken__image-wrap">
            {{ section.settings.image | image_url: width: 880 | image_tag: loading: 'lazy' }}
          </div>
          {%- if section.settings.caption != blank -%}
            <span class="rf-broken__caption">{{ section.settings.caption }}</span>
          {%- endif -%}
        {%- endif -%}
        <p class="rf-broken__text1" data-split-words>{{ section.settings.paragraph_1 }}</p>
      </div>

      <div class="rf-broken__scene2" data-scene="2">
        <h2 class="rf-broken__headline" data-split-chars>{{ section.settings.headline }}</h2>
      </div>
    </div>
  </div>

  <!-- Scene 3: Not pinned, scrolls normally -->
  <div class="rf-broken__scene3" data-scene="3">
    <p class="rf-broken__text2" data-split-words>{{ section.settings.paragraph_2 }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Broken System",
  "tag": "section",
  "class": "rf-broken-section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Real Food can solve this crisis."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1 (under image)",
      "default": "For decades we've been misled by guidance that prioritized highly processed food, and are now facing rates of unprecedented chronic disease."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2 (after headline)",
      "default": "For the first time, official U.S. guidance calls on Americans to avoid highly processed food. This is not an attack on industry or a legal definition. It reflects a public health reality families live with every day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (e.g. 1992 Food Pyramid)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image Caption",
      "default": "1992 Food Pyramid"
    }
  ],
  "presets": [
    {
      "name": "Broken System"
    }
  ]
}
{% endschema %}

<style>
/* ========================================
   PART 1 — Image + word-by-word text
   Sticky within 200vh wrapper, fades out
   ======================================== */
.rf-bs1 {
  background: #000;
  height: 200vh;
  position: relative;
  margin-bottom: -25vh;
}

.rf-bs1__sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5%;
  gap: 32px;
  will-change: opacity, transform, filter;
}

.rf-bs1__image {
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  overflow: hidden;
  max-width: 440px;
  width: 100%;
  opacity: 0.4;
  transform: translateY(-40px);
  will-change: opacity, transform;
}

.rf-bs1__image img {
  width: 100%;
  height: auto;
  display: block;
}

.rf-bs1__caption {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  margin: -20px 0 0;
}

.rf-bs1__text {
  font-size: clamp(18px, 2.5vw, 22px);
  line-height: 1.7;
  text-align: center;
  margin: 0;
  max-width: 680px;
}

.rf-bs1__text .w {
  color: rgba(255, 255, 255, 0.2);
  transition: color 0.15s ease;
}

.rf-bs1__text .w.lit {
  color: #fff;
}

/* ========================================
   PART 2 — Headline char-by-char reveal
   Pinned by GSAP, chars blur out with
   brightness + scale at end
   ======================================== */
.rf-bs2 {
  background: #000;
}

.rf-bs2__pin {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 5%;
}

.rf-bs2__headline {
  font-size: clamp(42px, 6vw, 72px);
  font-weight: 900;
  color: #fff;
  line-height: 1.1;
  margin: 0;
  text-align: center;
  max-width: 900px;
}

.rf-bs2__headline .ch {
  display: inline-block;
  opacity: 0;
  filter: blur(8px) brightness(1);
  transform: translateY(10px) scale(1);
}

.rf-bs2__headline .sp {
  display: inline;
}

/* ========================================
   PART 3 — Paragraph word color change
   NOT pinned. Words go #8d7d7d → white
   ======================================== */
.rf-bs3 {
  background: #000;
  padding: 100px 5% 120px;
  display: flex;
  justify-content: center;
}

.rf-bs3__text {
  font-size: clamp(17px, 2.2vw, 20px);
  line-height: 1.8;
  margin: 0;
  max-width: 780px;
  text-align: center;
}

.rf-bs3__text .w {
  color: #8d7d7d;
  transition: color 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.rf-bs3__text .w.lit {
  color: #fff;
}

/* ========================================
   Mobile
   ======================================== */
@media (max-width: 749px) {
  .rf-bs1 { height: 180vh; }
  .rf-bs1__sticky { gap: 20px; padding: 0 16px; }
  .rf-bs1__image { max-width: 300px; }
  .rf-bs3 { padding: 60px 5% 80px; }
}
</style>

<!-- ===== PART 1 ===== -->
<div class="rf-bs1">
  <div class="rf-bs1__sticky">
    {%- if section.settings.image != blank -%}
      <div class="rf-bs1__image">
        {{ section.settings.image | image_url: width: 880 | image_tag: loading: 'lazy' }}
      </div>
      {%- if section.settings.caption != blank -%}
        <span class="rf-bs1__caption">{{ section.settings.caption }}</span>
      {%- endif -%}
    {%- endif -%}
    <p class="rf-bs1__text">{{ section.settings.paragraph_1 }}</p>
  </div>
</div>

<!-- ===== PART 2 ===== -->
<div class="rf-bs2">
  <div class="rf-bs2__pin">
    <h2 class="rf-bs2__headline">{{ section.settings.headline }}</h2>
  </div>
</div>

<!-- ===== PART 3 ===== -->
<div class="rf-bs3">
  <p class="rf-bs3__text">{{ section.settings.paragraph_2 }}</p>
</div>

{% schema %}
{
  "name": "Broken System",
  "tag": "section",
  "class": "rf-broken-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (e.g. 1992 Food Pyramid)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image Caption",
      "default": "1992 Food Pyramid"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1 (under image)",
      "default": "For decades we've been misled by guidance that prioritized highly processed food, and are now facing rates of unprecedented chronic disease."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Real Food can solve this crisis."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2 (after headline)",
      "default": "For the first time, official U.S. guidance calls on Americans to avoid highly processed food. This is not an attack on industry or a legal definition. It reflects a public health reality families live with every day."
    }
  ],
  "presets": [{ "name": "Broken System" }]
}
{% endschema %}

<style>
/* === PART 1: Image + word highlight (sticky, 200vh) === */
.rf-broken-part1 {
  background: #000;
  height: 200vh;
  position: relative;
  margin-bottom: -25vh;
}

.rf-broken-part1__sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 5%;
  gap: 40px;
}

.rf-broken-part1__image-wrap {
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  overflow: hidden;
  max-width: 440px;
  width: 100%;
  opacity: 0.4;
  transform: translateY(-40px);
}

.rf-broken-part1__image-wrap img {
  width: 100%;
  height: auto;
  display: block;
}

.rf-broken-part1__caption {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  margin: -28px 0 0;
}

.rf-broken-part1__text {
  font-size: clamp(18px, 2.5vw, 22px);
  color: #ffffff;
  line-height: 1.7;
  text-align: center;
  margin: 0;
  max-width: 700px;
}

.rf-broken-part1__text .word {
  display: inline;
  color: rgba(255, 255, 255, 0.2);
  transition: color 0.15s ease;
}

.rf-broken-part1__text .word.is-lit {
  color: #ffffff;
}

/* === PART 2: Big headline with blur/brightness/scale (pinned by GSAP) === */
.rf-broken-part2 {
  background: #000;
  position: relative;
}

.rf-broken-part2__inner {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 5%;
}

.rf-broken-part2__headline {
  font-size: clamp(42px, 6vw, 72px);
  font-weight: 900;
  color: #ffffff;
  line-height: 1.1;
  margin: 0;
  text-align: center;
  max-width: 900px;
}

.rf-broken-part2__headline .char {
  display: inline-block;
  opacity: 0;
  filter: blur(8px) brightness(1);
  transform: translateY(10px) scale(1);
}

.rf-broken-part2__headline .char.is-visible {
  opacity: 1;
  filter: blur(0px) brightness(1);
  transform: translateY(0) scale(1);
}

.rf-broken-part2__headline .char-space {
  display: inline;
  width: 0.3em;
}

/* === PART 3: Second paragraph word highlight (not pinned) === */
.rf-broken-part3 {
  background: #000;
  padding: 120px 5%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rf-broken-part3__text {
  font-size: clamp(17px, 2.2vw, 20px);
  line-height: 1.7;
  margin: 0;
  max-width: 800px;
  text-align: center;
}

.rf-broken-part3__text .word {
  display: inline;
  color: #8d7d7d;
  opacity: 1;
  transition: color 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.rf-broken-part3__text .word.is-lit {
  color: #ffffff;
}

@media (max-width: 749px) {
  .rf-broken-part1 {
    height: 180vh;
  }

  .rf-broken-part1__sticky {
    gap: 24px;
    padding: 0 16px;
  }

  .rf-broken-part1__image-wrap {
    max-width: 300px;
  }

  .rf-broken-part3 {
    padding: 80px 5%;
  }
}
</style>

<!-- PART 1: Image + word highlight -->
<div class="rf-broken-part1">
  <div class="rf-broken-part1__sticky">
    {%- if section.settings.image != blank -%}
      <div class="rf-broken-part1__image-wrap">
        {{ section.settings.image | image_url: width: 880 | image_tag: loading: 'lazy' }}
      </div>
      {%- if section.settings.caption != blank -%}
        <span class="rf-broken-part1__caption">{{ section.settings.caption }}</span>
      {%- endif -%}
    {%- endif -%}
    <p class="rf-broken-part1__text">{{ section.settings.paragraph_1 }}</p>
  </div>
</div>

<!-- PART 2: Big headline with char animation -->
<div class="rf-broken-part2">
  <div class="rf-broken-part2__inner">
    <h2 class="rf-broken-part2__headline">{{ section.settings.headline }}</h2>
  </div>
</div>

<!-- PART 3: Second paragraph with word color change -->
<div class="rf-broken-part3">
  <p class="rf-broken-part3__text">{{ section.settings.paragraph_2 }}</p>
</div>

{% schema %}
{
  "name": "Broken System",
  "tag": "section",
  "class": "rf-broken-section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Real Food can solve this crisis."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1 (under image)",
      "default": "For decades we've been misled by guidance that prioritized highly processed food, and are now facing rates of unprecedented chronic disease."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2 (after headline)",
      "default": "For the first time, official U.S. guidance calls on Americans to avoid highly processed food. This is not an attack on industry or a legal definition. It reflects a public health reality families live with every day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (e.g. 1992 Food Pyramid)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image Caption",
      "default": "1992 Food Pyramid"
    }
  ],
  "presets": [
    {
      "name": "Broken System"
    }
  ]
}
{% endschema %}

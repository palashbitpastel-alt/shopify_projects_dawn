<style>
.rf-stats {
  background: #000000;
  width: 100%;
  padding: var(--padding-top, 120px) var(--padding-side, 5%) var(--padding-bottom, 120px);
}

.rf-stats__headline {
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 900;
  color: #ffffff;
  text-align: center;
  margin: 0 0 16px;
  line-height: 1.1;
}

.rf-stats__subheadline {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  margin: 0 0 80px;
}

.rf-stats__divider {
  width: 100%;
  height: 1px;
  background: rgba(255, 255, 255, 0.15);
  margin-bottom: 60px;
}

.rf-stats__grid {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 50px;
  max-width: 1200px;
  margin: 0 auto;
  flex-wrap: wrap;
}

.rf-stats__item {
  flex: 1;
  min-width: 120px;
  max-width: 300px;
  text-align: center;
}

/* Number on top of the bar */
.rf-stats__number {
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
  margin: 0 0 -72px;
}

.rf-stats__unit {
  font-size: inherit;
  font-weight: inherit;
}

/* Red bar that grows upward */
.rf-stats__bar {
  width: 100%;
  height: 0;
  display: block !important;
  background: #cc0000;
  min-height: calc(100% + 70px);
}

/* Label below bar */
.rf-stats__label {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.5;
  margin: 16px 0 0;
}

@media (max-width: 749px) {
  .rf-stats {
    padding: 80px 5%;
  }

  .rf-stats__grid {
    gap: 20px;
  }

  .rf-stats__subheadline {
    margin-bottom: 48px;
  }

  .rf-stats__number {
    font-size: clamp(24px, 5vw, 32px);
  }

  .rf-stats__label {
    font-size: 12px;
  }
}
</style>

<section class="rf-stats" data-section-id="{{ section.id }}" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --padding-side: {{ section.settings.padding_side }}%">
  <h2 class="rf-stats__headline rf-headline">{{ section.settings.headline }}</h2>
  <p class="rf-stats__subheadline">{{ section.settings.subheadline }}</p>

  <div class="rf-stats__divider"></div>

  <div class="rf-stats__grid">
    {%- for block in section.blocks -%}
      <div class="rf-stats__item" {{ block.shopify_attributes }}>
        <p class="rf-stats__number">
          <span class="rf-stats__value" data-target="{{ block.settings.number }}">0</span><span class="rf-stats__unit">{{ block.settings.unit }}</span>
        </p>
        <div class="rf-stats__bar" data-bar-target="{{ block.settings.number }}">&nbsp;</div>
        <p class="rf-stats__label">{{ block.settings.label }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Stats Counter",
  "tag": "section",
  "class": "rf-stats-section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "The State of Our Health"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "America is sick. The data is clear."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "%",
      "label": "Padding Left/Right",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "range",
          "id": "number",
          "label": "Number",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit",
          "default": "%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "of Americans have prediabetes or diabetes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats Counter",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": 50,
            "unit": "%",
            "label": "of Americans have prediabetes or diabetes"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": 75,
            "unit": "%",
            "label": "of adults report having at least one chronic condition"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": 90,
            "unit": "%",
            "label": "of U.S. healthcare spending goes to treating chronic disease"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.rf-pyramid {
  background: #000;
  width: 100%;
  position: relative;
}

.rf-pyramid__title {
  font-size: clamp(48px, 7vw, 80px);
  font-weight: 900;
  color: #ffffff;
  text-align: center;
  padding: 100px 5% 60px;
  margin: 0;
  line-height: 1.05;
}

.rf-pyramid__panels {
  position: relative;
  height: 100vh;
}

.rf-pyramid__panel {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  padding: 0 5%;
  opacity: 0;
}

.rf-pyramid__panel:first-child {
  opacity: 1;
}

.rf-pyramid__panel-text {
  opacity: 0;
  transform: translateX(-30px);
}

.rf-pyramid__category {
  font-size: clamp(36px, 4vw, 52px);
  font-weight: 900;
  color: #ffffff;
  line-height: 1.15;
  margin: 0 0 24px;
}

.rf-pyramid__body {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.7;
  margin: 0;
  max-width: 480px;
}

.rf-pyramid__images {
  position: relative;
  height: 70vh;
  min-height: 400px;
}

.rf-pyramid__img {
  position: absolute;
  opacity: 0;
  will-change: transform, opacity;
}

.rf-pyramid__img img {
  max-width: 100%;
  height: auto;
  display: block;
  filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.4));
}

/* Image positions — scattered layout */
.rf-pyramid__img:nth-child(1) { top: 5%; left: 10%; width: 28%; }
.rf-pyramid__img:nth-child(2) { top: 8%; right: 5%; width: 24%; }
.rf-pyramid__img:nth-child(3) { top: 35%; left: 5%; width: 22%; }
.rf-pyramid__img:nth-child(4) { top: 30%; left: 40%; width: 26%; }
.rf-pyramid__img:nth-child(5) { top: 25%; right: 8%; width: 20%; }
.rf-pyramid__img:nth-child(6) { top: 55%; left: 15%; width: 25%; }
.rf-pyramid__img:nth-child(7) { top: 60%; right: 12%; width: 22%; }
.rf-pyramid__img:nth-child(8) { top: 75%; left: 5%; width: 20%; }
.rf-pyramid__img:nth-child(9) { top: 70%; left: 45%; width: 24%; }
.rf-pyramid__img:nth-child(10) { top: 80%; right: 5%; width: 18%; }
.rf-pyramid__img:nth-child(11) { top: 15%; left: 35%; width: 20%; }
.rf-pyramid__img:nth-child(12) { top: 50%; right: 2%; width: 22%; }

/* Panel indicator dots */
.rf-pyramid__dots {
  position: absolute;
  right: 30px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 12px;
  z-index: 10;
}

.rf-pyramid__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transition: background 0.3s ease;
}

.rf-pyramid__dot.is-active {
  background: #ffffff;
}

@media (max-width: 749px) {
  .rf-pyramid__panel {
    grid-template-columns: 1fr;
    padding: 60px 5%;
    height: auto;
    min-height: 100vh;
  }

  .rf-pyramid__images {
    height: 50vh;
    min-height: 300px;
  }

  .rf-pyramid__title {
    padding: 60px 5% 40px;
  }

  .rf-pyramid__dots {
    display: none;
  }
}
</style>

<section class="rf-pyramid" data-section-id="{{ section.id }}">
  <h2 class="rf-pyramid__title rf-headline">{{ section.settings.title }}</h2>

  <div class="rf-pyramid__panels">
    {%- for block in section.blocks -%}
      <div class="rf-pyramid__panel" data-panel-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="rf-pyramid__panel-text">
          <h3 class="rf-pyramid__category">{{ block.settings.category }}</h3>
          <p class="rf-pyramid__body">{{ block.settings.body }}</p>
        </div>
        <div class="rf-pyramid__images">
          {%- for i in (1..12) -%}
            {%- assign img_key = 'image_' | append: i -%}
            {%- if block.settings[img_key] != blank -%}
              <div class="rf-pyramid__img">
                {{ block.settings[img_key] | image_url: width: 400 | image_tag: loading: 'lazy' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    <div class="rf-pyramid__dots">
      {%- for block in section.blocks -%}
        <div class="rf-pyramid__dot {% if forloop.first %}is-active{% endif %}"></div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Food Pyramid",
  "tag": "section",
  "class": "rf-pyramid-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Eat Real Food"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Food Panel",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category Label",
          "default": "Protein, Dairy, & Healthy Fats"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body Text",
          "default": "We are ending the war on protein and healthy fats. Meat, eggs, dairy, and fish are real food — nutrient-dense and essential."
        },
        { "type": "image_picker", "id": "image_1", "label": "Food Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Food Image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Food Image 3" },
        { "type": "image_picker", "id": "image_4", "label": "Food Image 4" },
        { "type": "image_picker", "id": "image_5", "label": "Food Image 5" },
        { "type": "image_picker", "id": "image_6", "label": "Food Image 6" },
        { "type": "image_picker", "id": "image_7", "label": "Food Image 7" },
        { "type": "image_picker", "id": "image_8", "label": "Food Image 8" },
        { "type": "image_picker", "id": "image_9", "label": "Food Image 9" },
        { "type": "image_picker", "id": "image_10", "label": "Food Image 10" },
        { "type": "image_picker", "id": "image_11", "label": "Food Image 11" },
        { "type": "image_picker", "id": "image_12", "label": "Food Image 12" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Food Pyramid",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "category": "Protein, Dairy, & Healthy Fats",
            "body": "We are ending the war on protein and healthy fats. Meat, eggs, dairy, and fish are real food — nutrient-dense and essential."
          }
        },
        {
          "type": "panel",
          "settings": {
            "category": "Vegetables & Fruits",
            "body": "Vegetables and fruits are the foundation of a healthy plate. Choose whole, unprocessed produce — the closer to the farm, the better."
          }
        },
        {
          "type": "panel",
          "settings": {
            "category": "Whole Grains",
            "body": "Whole grains — not refined flour and sugar — provide sustained energy. Choose real bread, oats, and rice over processed cereals."
          }
        }
      ]
    }
  ]
}
{% endschema %}

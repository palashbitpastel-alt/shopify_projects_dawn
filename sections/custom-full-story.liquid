<style>
.rf-story {
  background: #3d4a3e;
  padding: 100px 5%;
  text-align: center;
}

.rf-story__inner {
  max-width: 700px;
  margin: 0 auto;
}

.rf-story__headline {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 900;
  color: #fff;
  line-height: 1.2;
  margin: 0 0 16px;
}

.rf-story__sub {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  margin: 0 0 32px;
}

.rf-story__btn {
  display: inline-block;
  padding: 14px 36px;
  background: #fff;
  color: #1a1a1a;
  font-weight: 700;
  font-size: 16px;
  border-radius: 100px;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s;
}

.rf-story__btn:hover {
  background: #e8e8e8;
  transform: scale(1.03);
}
</style>

<section class="rf-story" data-section-id="{{ section.id }}">
  <div class="rf-story__inner">
    <h2 class="rf-story__headline">{{ section.settings.headline }}</h2>
    <p class="rf-story__sub">{{ section.settings.subtext }}</p>
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_url }}" class="rf-story__btn">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Get the Full Story",
  "tag": "section",
  "class": "rf-story-section",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Use this guide to learn more about real food" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Read the Dietary Guidelines for Americans" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Read the full guidelines" },
    { "type": "url", "id": "button_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Get the Full Story" }]
}
{% endschema %}
